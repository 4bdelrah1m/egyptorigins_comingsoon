# ── Google Analytics 4 ────────────────────────────────────────────────────────
# GA4 Admin → Data streams → your web stream → Measurement ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── Microsoft Clarity ─────────────────────────────────────────────────────────
# clarity.microsoft.com → your project → Settings → Setup
NEXT_PUBLIC_CLARITY_ID=xxxxxxxxxx

# ── Launch countdown ──────────────────────────────────────────────────────────
# ISO 8601 target (Cairo time = +02:00) and the label shown beneath it.
NEXT_PUBLIC_LAUNCH_DATE=2027-01-15T18:00:00+02:00
NEXT_PUBLIC_LAUNCH_LABEL=15 January 2027

# ── Canonical site URL (no trailing slash) ────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://egyptorigin.com

# ── Waitlist signup notification ──────────────────────────────────────────────
# Each new signup emails this inbox via FormSubmit (no API key needed).
# The first submission sends a confirmation link you must click once.
WAITLIST_NOTIFICATION_EMAIL=abdelrahim.nabil.hamad@gmail.com

# ── Optional durable signup mirror ────────────────────────────────────────────
# POSTs { event, email, source, campaign, position, createdAt } as JSON.
# Use a Zapier/Make/Sheets/DB webhook in serverless deployments.
WAITLIST_WEBHOOK_URL=
